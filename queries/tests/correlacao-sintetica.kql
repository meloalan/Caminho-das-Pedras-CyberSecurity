    -1, 4624, "fora-da-janela", "LAB-01", "192.0.2.10", 3,
    -6, 4625, "ip-diferente", "LAB-01", "192.0.2.10", 3,
    -5, 4625, "ip-diferente", "LAB-01", "192.0.2.10", 3,
    -4, 4625, "ip-diferente", "LAB-01", "192.0.2.10", 3,
    -3, 4625, "ip-diferente", "LAB-01", "192.0.2.10", 3,
