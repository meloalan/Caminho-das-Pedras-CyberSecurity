// DADOS SINTETICOS: nenhuma autenticação é gerada. Execute o arquivo completo.
let Now = now();
let SecurityEvent = datatable(OffsetMinutes:long, EventID:int, TargetAccount:string, Computer:string, IpAddress:string, LogonType:int)
[
    -6, 4625, "positivo", "LAB-01", "192.0.2.10", 3,
