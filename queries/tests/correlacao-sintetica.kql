    -2, 4625, "mesmo-instante", "LAB-01", "192.0.2.10", 3,
    -1, 4625, "mesmo-instante", "LAB-01", "192.0.2.10", 3,
    -1, 4624, "mesmo-instante", "LAB-01", "192.0.2.10", 3,
    -6, 4625, "ip-vazio", "LAB-01", "", 3,
    -5, 4625, "ip-vazio", "LAB-01", "", 3,
